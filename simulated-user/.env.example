# Required: Your OpenAI API key
OPENAI_API_KEY=sk-your-api-key-here

# Required: The website URL to test
TARGET_URL=https://example.com

# Optional: Specific goal for the AI user
USER_GOAL=Find and click the sign up button

# Optional: Maximum iterations to run (default: 5)
# NOTE: The session may end early if:
#   - AI reaches end state (action="none")
#   - AI confidence drops below 30% 
#   - AI has 2+ consecutive uncertain actions (confidence < 50%)
# MAX_ITERATIONS acts as a hard limit, but early stopping can trigger before it
MAX_ITERATIONS=5

# Optional: Output directory for results (default: ./output)
OUTPUT_DIR=./output

# Optional: Run in headless mode (default: true)
HEADLESS=true

# SUS Evaluation
# System Usability Scale (SUS) is automatically evaluated at the end of each session
# It evaluates 5 dimensions: Learnability, Efficiency, Memorability, Error Prevention, Satisfaction
# The overall SUS score (0-100) indicates: <50="poor", 50-68="ok", >68="good"
