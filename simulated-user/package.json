{
  "name": "simulated-user",
  "version": "1.0.0",
  "description": "AI-powered simulated user for website usability testing with Playwright and OpenAI Vision",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/main.ts",
    "verify": "node --loader ts-node/esm verify.ts",
    "example": "node --loader ts-node/esm example.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "playwright",
    "openai",
    "usability-testing",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.10",
    "openai": "^4.52.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
